# Copy to .env and fill every placeholder. Never commit .env.

# Provider credentials, used only by the LiteLLM Proxy
GROQ_API_KEY=replace-with-your-primary-groq-key
GROQ_FALLBACK_API_KEY=replace-with-a-second-groq-key
GUARDRAIL_MODEL=openai/gpt-oss-20b

# Proxy authentication. Use a long, random value beginning with sk-.
LITELLM_MASTER_KEY=sk-replace-with-a-long-random-secret
LITELLM_PROXY_URL=http://127.0.0.1:4000/v1
LITELLM_RAG_MODEL=rag-primary
LITELLM_GUARDRAIL_MODEL=guardrails

# Existing application services
QDRANT_API_KEY=replace-with-qdrant-key
QDRANT_CLUSTER_ENDPOINT=https://your-qdrant-endpoint
GEMINI_API_KEY=replace-with-gemini-key
LOGFIRE_TOKEN=replace-with-logfire-token
BACKEND_URL=http://127.0.0.1:8000
